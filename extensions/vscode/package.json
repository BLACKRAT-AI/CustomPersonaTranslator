{
  "name": "cpt-vscode-bridge",
  "displayName": "CPT — VS Code Bridge (Claude Code)",
  "description": "Forwards Claude Code final responses to the CustomPersonaTranslator desktop app and lets it inject replies.",
  "version": "0.1.0",
  "publisher": "cpt-local",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "cpt.toggle", "title": "CPT: Toggle Connection" },
      { "command": "cpt.captureSelection", "title": "CPT: Capture Selection as Final" }
    ]
  },
  "scripts": {},
  "dependencies": { "ws": "^8.18.0" }
}
