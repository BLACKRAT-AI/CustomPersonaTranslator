<v:SettingsPage x:Class="CPT.Shell.Views.TestTranslateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:CPT.Shell.Views"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Paste an assistant-style response (Markdown OK). Tables / code blocks will be skipped or announced. The current persona will translate and speak it."
                   TextWrapping="Wrap" />
        <TextBox Grid.Row="1" x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
        <TextBlock Grid.Row="2" x:Name="Status" Text="" Opacity="0.7" FontSize="11" />
        <TextBlock Grid.Row="3" x:Name="Filtered" Text="" FontFamily="Consolas" FontSize="11"
                   Opacity="0.85" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Filter only" Click="OnFilter" />
            <Button Content="Translate &amp; speak" Click="OnTranslate" FontWeight="SemiBold" />
            <Button Content="Close" Click="OnClose" />
        </StackPanel>
    </Grid>
</v:SettingsPage>
