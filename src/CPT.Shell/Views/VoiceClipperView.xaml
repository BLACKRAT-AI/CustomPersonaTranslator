<v:SettingsPage x:Class="CPT.Shell.Views.VoiceClipperView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:CPT.Shell.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ctl="clr-namespace:CPT.Shell.Controls"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI">

    <DockPanel>
        <!-- Link bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource HeaderStrip}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Load"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Click="OnLoad"/>
                <TextBox x:Name="UrlBox"
                         Margin="0"
                         KeyDown="OnUrlKeyDown"
                         ToolTip="Paste a YouTube link"/>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <Border DockPanel.Dock="Bottom"
                Background="#FF1C1C1C"
                BorderBrush="{StaticResource BorderBr}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="Status"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="UseButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Content="Use these clips"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="OnUseClips"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancel"/>
            </DockPanel>
        </Border>

        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <!-- Video -->
            <Border Grid.Row="0"
                    Background="#FF0D0D0D"
                    BorderBrush="{StaticResource BorderBr}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="Video" Visibility="Collapsed"/>
                    <TextBlock x:Name="VideoPlaceholder"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               TextAlignment="Center"
                               Text="Paste a YouTube link above and choose Load."/>
                </Grid>
            </Border>

            <!-- Transport -->
            <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
                <Button x:Name="PlayButton"
                        DockPanel.Dock="Left"
                        Content="Play"
                        MinWidth="76"
                        IsEnabled="False"
                        Click="OnTogglePlay"/>

                <Button x:Name="MarkButton"
                        DockPanel.Dock="Left"
                        Style="{StaticResource PrimaryButton}"
                        Content="Start clip"
                        MinWidth="130"
                        MinHeight="0"
                        Padding="16,7"
                        FontSize="12"
                        IsEnabled="False"
                        Click="OnMark"
                        ToolTip="Mark the start of a section in this voice, then mark its end  (M)"/>

                <TextBlock x:Name="TimeLabel"
                           DockPanel.Dock="Left"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Text="0:00 / 0:00"/>

                <TextBlock x:Name="TotalLabel"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource Muted}"/>
            </DockPanel>

            <!-- Tag strip -->
            <ctl:ClipTimeline x:Name="Timeline"
                              Grid.Row="2"
                              Margin="0,10,0,0"
                              AutomationProperties.Name="Clip timeline"/>

            <TextBlock Grid.Row="3"
                       Margin="2,6,0,0"
                       Style="{StaticResource Hint}"
                       Text="Mark the stretches where only the voice you want is speaking — aim for 15–30 seconds. Drag the strip to scrub, drag a clip's edge to trim it, drag its middle to slide it."/>

            <!-- Marked clips -->
            <ListBox x:Name="ClipList"
                     Grid.Row="4"
                     Margin="0,10,0,0"
                     Background="{StaticResource FieldBg}"
                     BorderBrush="{StaticResource BorderBr}"
                     BorderThickness="1"
                     Padding="4"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Margin="4,3">
                            <Button DockPanel.Dock="Right"
                                    Content="Remove"
                                    Margin="8,0,0,0"
                                    Padding="10,3"
                                    Click="OnRemoveClip"/>
                            <Button DockPanel.Dock="Right"
                                    Content="Go to"
                                    Padding="10,3"
                                    Click="OnGoToClip"/>
                            <TextBlock Text="{Binding Range}"
                                       VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12"
                                       Foreground="{StaticResource Text}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</v:SettingsPage>
