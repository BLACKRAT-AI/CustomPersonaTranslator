<v:SettingsPage x:Class="CPT.Shell.Views.CliSetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:CPT.Shell.Views"
        xmlns:vm="clr-namespace:CPT.Shell.ViewModels"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI">

    <DockPanel>
        <Border Style="{StaticResource HeaderStrip}" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="CONNECT A CODING CLI"
                           Foreground="{StaticResource Muted}"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Pick one. CPT installs it for you — all you do is sign in with your own account."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#FF1C1C1C"
                BorderBrush="{StaticResource BorderBr}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="FooterHint"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Re-check all" Click="OnRefreshAll"/>
            </DockPanel>
        </Border>

        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ItemsControl x:Name="ProviderList" Grid.Row="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CliProviderRow}">
                        <Border Margin="0,0,0,8"
                                Padding="14,12"
                                CornerRadius="8"
                                Background="#FF1E1E1E"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBr}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            <Setter Property="Background" Value="#FF232A2C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             GroupName="Provider"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Checked="OnProviderChecked"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="{Binding Vendor}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Ellipse Width="7" Height="7"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding StatusBrush}"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        MinWidth="104"
                                        Margin="12,0,0,0"
                                        Content="{Binding ActionText}"
                                        IsEnabled="{Binding IsActionEnabled}"
                                        Click="OnProviderAction"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Installer output, and the sign-in terminal when one is running. -->
            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="{StaticResource FieldDk}"
                    BorderBrush="{StaticResource BorderBr}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="10,6"
                            Background="#FF141414"
                            BorderBrush="{StaticResource BorderBr}"
                            BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <Viewbox DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconTerminal}"
                                      Stroke="{StaticResource Muted}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="24" Height="24" Stretch="None"/>
                            </Viewbox>
                            <TextBlock x:Name="ConsoleTitle"
                                       Text="Output"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                    </Border>

                    <!-- Shown only during an interactive sign-in. -->
                    <Border x:Name="TerminalInputRow"
                            DockPanel.Dock="Bottom"
                            Visibility="Collapsed"
                            Padding="8"
                            Background="#FF141414"
                            BorderBrush="{StaticResource BorderBr}"
                            BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Cancel sign-in"
                                    Margin="8,0,0,0"
                                    Click="OnCancelSignIn"/>
                            <TextBox x:Name="TerminalInput"
                                     Margin="0"
                                     FontFamily="Cascadia Mono, Consolas"
                                     KeyDown="OnTerminalInputKey"
                                     ToolTip="Type here and press Enter to answer the CLI"/>
                        </DockPanel>
                    </Border>

                    <TextBox x:Name="ConsoleOutput"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#FFCFCFCF"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11.5"
                             Padding="10"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</v:SettingsPage>
