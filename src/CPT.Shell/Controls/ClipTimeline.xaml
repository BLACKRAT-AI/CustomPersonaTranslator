<UserControl x:Class="CPT.Shell.Controls.ClipTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="54"
             ClipToBounds="True">

    <Border Background="#FF141414"
            BorderBrush="{StaticResource BorderBr}"
            BorderThickness="1"
            CornerRadius="6"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- Marked regions, the in-progress mark and the playhead are drawn
                 into this canvas from code, because their geometry depends on
                 the media duration and the control's live width. -->
            <Canvas x:Name="Surface"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    SizeChanged="OnSurfaceSizeChanged"/>

            <!-- Input goes to an explicit filled rectangle laid over the canvas.
                 A Canvas only reports hits where it has drawn something, and its
                 children are shapes that come and go on every redraw, so pointing
                 the handlers at it meant presses landed on nothing at all. -->
            <Rectangle x:Name="InputSurface"
                       Fill="Transparent"
                       Cursor="Hand"
                       MouseLeftButtonDown="OnSurfaceMouseDown"
                       MouseLeftButtonUp="OnSurfaceMouseUp"
                       MouseMove="OnSurfaceMouseMove"
                       MouseLeave="OnSurfaceMouseLeave"/>
        </Grid>
    </Border>
</UserControl>
