<Window x:Class="CPT.Shell.PersonaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Persona"
        Width="420" Height="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <!-- Top zone:  transparent area for the hologram, with a tinted projector
                    cone drawn behind the persona canvas.
         Bottom zone: the compact projector bar. Draggable, snaps to edges. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============== HOLOGRAM ZONE ============== -->
        <Grid Grid.Row="0" x:Name="HoloZone" ClipToBounds="True">
            <!-- A triangle whose base sits at the bottom of this zone, right
                 above the bar's lens, and whose apex reaches the persona's
                 head. The vertical gradient fades from the persona colour at
                 the base to transparent at the apex, so it reads as a beam. -->
            <Polygon x:Name="ProjectorCone"
                     IsHitTestVisible="False"
                     Stretch="Fill"
                     Points="0.5,0 0,1 1,1">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                        <GradientStop x:Name="ConeStop0" Color="#996FC2D6" Offset="0.0"/>
                        <GradientStop x:Name="ConeStop1" Color="#446FC2D6" Offset="0.35"/>
                        <GradientStop x:Name="ConeStop2" Color="#1A6FC2D6" Offset="0.7"/>
                        <GradientStop x:Name="ConeStop3" Color="#006FC2D6" Offset="1.0"/>
                    </LinearGradientBrush>
                </Polygon.Fill>
            </Polygon>

            <wv2:WebView2 x:Name="Web"/>
        </Grid>

        <!-- ============== PROJECTOR BAR ============== -->
        <Grid Grid.Row="1">
            <!-- A short halo on the top edge of the bar, so the cone above
                 visually originates from a thin line of light. -->
            <Rectangle x:Name="ProjectorHalo"
                       Height="10"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop x:Name="HaloStop0" Color="#006FC2D6" Offset="0.0"/>
                        <GradientStop x:Name="HaloStop1" Color="#996FC2D6" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="ProjectorEdge"
                       Height="2"
                       VerticalAlignment="Top"
                       Margin="20,0"
                       Fill="#FF6FC2D6"
                       Opacity="0.92"
                       IsHitTestVisible="False"/>

            <Border x:Name="Bar"
                    Background="#F2161616"
                    BorderBrush="#FF333333"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,2,0,0"
                    MouseLeftButtonDown="OnBarDragStart"
                    Cursor="SizeAll">
                <Grid Margin="6,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: the controls. -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button x:Name="SettingsBtn"
                                DockPanel.Dock="Left"
                                Style="{StaticResource ToolbarIconButton}"
                                Tag="{StaticResource IconSettings}"
                                Click="OnOpenSettings"
                                AutomationProperties.Name="Settings"
                                ToolTip="Settings"/>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="StandbyToggle"
                                          Style="{StaticResource ToolbarIconToggle}"
                                          Tag="{StaticResource IconWaveform}"
                                          Checked="OnStandbyChecked"
                                          Unchecked="OnStandbyUnchecked"
                                          AutomationProperties.Name="Standby"
                                          ToolTip="Standby — wake with a spoken phrase  (S)"/>
                            <ToggleButton x:Name="AvatarToggle"
                                          Style="{StaticResource ToolbarIconToggle}"
                                          Tag="{StaticResource IconAvatar}"
                                          IsChecked="True"
                                          Checked="OnAvatarToggled"
                                          Unchecked="OnAvatarToggled"
                                          AutomationProperties.Name="Avatar"
                                          ToolTip="Show or hide the avatar  (A)"/>
                            <ToggleButton x:Name="PinToggle"
                                          Style="{StaticResource ToolbarIconToggle}"
                                          Tag="{StaticResource IconPin}"
                                          Checked="OnPinToggled"
                                          Unchecked="OnPinToggled"
                                          AutomationProperties.Name="Pin"
                                          ToolTip="Keep the hologram on screen  (P)"/>
                            <Button x:Name="HideBtn"
                                    Style="{StaticResource ToolbarIconButton}"
                                    Tag="{StaticResource IconClose}"
                                    Click="OnHide"
                                    AutomationProperties.Name="Hide"
                                    ToolTip="Hide  (Esc)"/>
                        </StackPanel>

                        <!-- Press and hold to talk. Fills the space between the
                             menu button and the toggles. -->
                        <Border x:Name="MicSurface"
                                Margin="6,0"
                                Background="#FF232323"
                                BorderBrush="#FF3A3A3A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="OnMicDown"
                                PreviewMouseLeftButtonUp="OnMicUp"
                                AutomationProperties.Name="Hold to talk"
                                ToolTip="Hold to talk  (Ctrl+Shift+M)">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0">
                                    <Path x:Name="MicIcon"
                                          Data="{StaticResource IconMic}"
                                          Stroke="#FFB4B4B4"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="24" Height="24"
                                          Stretch="None"/>
                                </Viewbox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderName"
                                               Text="PERSONA"
                                               Foreground="#FFEAEAEA"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MicHint"
                                               Text="hold to talk"
                                               Foreground="#FF8C8C8C"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- Row 1: which CLI is linked, and what it is doing. -->
                    <Border Grid.Row="1"
                            x:Name="CliStrip"
                            Margin="2,5,2,0"
                            Padding="8,4"
                            CornerRadius="7"
                            Background="#FF1B1B1B"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnCliStripClick"
                            ToolTip="Open CLI setup">
                        <DockPanel LastChildFill="True">
                            <Ellipse x:Name="CliStatusDot"
                                     DockPanel.Dock="Left"
                                     Width="7" Height="7"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="#FF6E6E6E"/>
                            <TextBlock x:Name="CliStatusText"
                                       Text="Checking CLI…"
                                       Foreground="#FF9A9A9A"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
