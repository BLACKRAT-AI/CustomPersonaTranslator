<Window x:Class="CPT.Shell.PersonaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:CPT.Shell"
        Title="Persona"
        Width="330" Height="640"
        MinWidth="240" MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <!-- ONE panel: the projection and the controls under it are a single modal,
         with the prismatic ring tracing its whole perimeter. The panel is inset
         a few pixels from the window edge so the ring's bloom has somewhere to
         fall, and the WebView is inset inside that so it cannot paint over the
         ring (a WebView2 is a child HWND and always wins against WPF). -->
    <Grid x:Name="Root" Margin="10">
        <Border x:Name="Panel"
                Background="#E60D0F13"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============== HOLOGRAM ZONE ============== -->
                <Grid Grid.Row="0" x:Name="HoloZone" ClipToBounds="True" Margin="2,2,2,0">
                    <wv2:WebView2 x:Name="Web"/>
                </Grid>

                <!-- ============== PROJECTOR BAR ============== -->
                <Grid Grid.Row="1">
                    <!-- Part of the panel now, not a card floating on top of it:
                         no border, no corners of its own, just a hairline to
                         separate the controls from the projection above. -->
                    <Border x:Name="Bar"
                            Background="#26FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="0,1,0,0"
                            MouseLeftButtonDown="OnBarDragStart"
                            Cursor="SizeAll">
                        <Grid Margin="6,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
        
                            <!-- Row 0: the controls. -->
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button x:Name="SettingsBtn"
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource ToolbarIconButton}"
                                        Tag="{StaticResource IconSettings}"
                                        Click="OnOpenSettings"
                                        AutomationProperties.Name="Settings"
                                        ToolTip="Settings"/>
        
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="StandbyToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconWaveform}"
                                                  Checked="OnStandbyChecked"
                                                  Unchecked="OnStandbyUnchecked"
                                                  AutomationProperties.Name="Standby"
                                                  ToolTip="Standby — wake with a spoken phrase  (S)"/>
                                    <ToggleButton x:Name="AvatarToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconAvatar}"
                                                  IsChecked="True"
                                                  Checked="OnAvatarToggled"
                                                  Unchecked="OnAvatarToggled"
                                                  AutomationProperties.Name="Avatar"
                                                  ToolTip="Show or hide the avatar  (A)"/>
                                    <ToggleButton x:Name="PinToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconPin}"
                                                  Checked="OnPinToggled"
                                                  Unchecked="OnPinToggled"
                                                  AutomationProperties.Name="Pin"
                                                  ToolTip="Keep the hologram on screen  (P)"/>
                                    <Button x:Name="HideBtn"
                                            Style="{StaticResource ToolbarIconButton}"
                                            Tag="{StaticResource IconClose}"
                                            Click="OnHide"
                                            AutomationProperties.Name="Hide"
                                            ToolTip="Hide  (Esc)"/>
                                </StackPanel>
        
                                <!-- Press and hold to talk. Fills the space between the
                                     menu button and the toggles. -->
                                <Border x:Name="MicSurface"
                                        Margin="6,0"
                                        Background="#FF232323"
                                        BorderBrush="#FF3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="OnMicDown"
                                        PreviewMouseLeftButtonUp="OnMicUp"
                                        AutomationProperties.Name="Hold to talk"
                                        ToolTip="Hold to talk  (Ctrl+Shift+M)">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
        
                                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0">
                                            <Path x:Name="MicIcon"
                                                  Data="{StaticResource IconMic}"
                                                  Stroke="#FFB4B4B4"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="24" Height="24"
                                                  Stretch="None"/>
                                        </Viewbox>
        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="HeaderName"
                                                       Text="PERSONA"
                                                       Foreground="#FFEAEAEA"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MicHint"
                                                       Text="hold to talk"
                                                       Foreground="#FF8C8C8C"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
        
                            <!-- Row 1: which agent is answering. Switching here is the
                                 manual alternative to speaking an agent's phrase. -->
                            <DockPanel Grid.Row="1" Margin="2,5,2,0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="AGENT"
                                           Foreground="#FF7A7A7A" FontSize="9" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <ComboBox x:Name="AgentPicker"
                                          SelectionChanged="OnAgentPicked"
                                          AutomationProperties.Name="Active agent"
                                          ToolTip="Which agent answers -- a CLI paired with a persona"/>
                            </DockPanel>

                            <!-- Row 2: which CLI is linked, and what it is doing. -->
                            <Border Grid.Row="2"
                                    x:Name="CliStrip"
                                    Margin="2,5,2,0"
                                    Padding="8,4"
                                    CornerRadius="7"
                                    Background="#FF1B1B1B"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnCliStripClick"
                                    ToolTip="Open CLI setup">
                                <DockPanel LastChildFill="True">
                                    <Ellipse x:Name="CliStatusDot"
                                             DockPanel.Dock="Left"
                                             Width="7" Height="7"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="#FF6E6E6E"/>
                                    <TextBlock x:Name="CliStatusText"
                                               Text="Checking CLI…"
                                               Foreground="#FF9A9A9A"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- SYNTAX's prismatic ring, tracing the panel's whole perimeter.
             Last in the Grid so it is on top of the panel, and outside the
             panel's clip so its bloom can spill into the window's margin. -->
        <local:PrismaticBorder x:Name="Ring" CornerRadius="14"/>
    </Grid>
</Window>
