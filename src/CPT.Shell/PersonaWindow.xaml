<Window x:Class="CPT.Shell.PersonaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:CPT.Shell"
        Title="Persona"
        Width="460" Height="530"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <!-- NO panel. The hologram is projected onto nothing, exactly as SYNTAX
         does it: a transparent canvas, with a soft dark radial drawn only
         behind the head so the dots have contrast. A panel behind it clipped
         that radial and put a slab of glass on the screen.

         The modal is the bar at the bottom, and the prismatic ring traces THAT.
         The WebView2 is a child HWND that always paints over WPF, so the ring
         lives in the bar's own row where the WebView cannot cover it. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============== HOLOGRAM ZONE ============== -->
        <Grid Grid.Row="0" x:Name="HoloZone" ClipToBounds="True">
            <wv2:WebView2 x:Name="Web"/>
        </Grid>

        <!-- ============== PROJECTOR BAR ============== -->
        <!-- Generous margin on purpose: the ring's bloom is a drop shadow and
             was being cut off square by the window edge. This is the room it
             needs to fade all the way to nothing. -->
        <Grid Grid.Row="1" Margin="26,0,26,24">
            <Border x:Name="Bar"
                    Background="#F2141619"
                    BorderBrush="#FF33363D"
                    BorderThickness="1"
                    CornerRadius="14"
                    MouseLeftButtonDown="OnBarDragStart"
                    Cursor="SizeAll">
                <Grid Margin="6,5">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        
                            <!-- Row 0: the controls. -->
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button x:Name="SettingsBtn"
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource ToolbarIconButton}"
                                        Tag="{StaticResource IconSettings}"
                                        Click="OnOpenSettings"
                                        AutomationProperties.Name="Settings"
                                        ToolTip="Settings"/>
        
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="StandbyToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconWaveform}"
                                                  Checked="OnStandbyChecked"
                                                  Unchecked="OnStandbyUnchecked"
                                                  AutomationProperties.Name="Standby"
                                                  ToolTip="Standby — wake with a spoken phrase  (S)"/>
                                    <ToggleButton x:Name="AvatarToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconAvatar}"
                                                  IsChecked="True"
                                                  Checked="OnAvatarToggled"
                                                  Unchecked="OnAvatarToggled"
                                                  AutomationProperties.Name="Avatar"
                                                  ToolTip="Show or hide the avatar  (A)"/>
                                    <ToggleButton x:Name="PinToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconPin}"
                                                  Checked="OnPinToggled"
                                                  Unchecked="OnPinToggled"
                                                  AutomationProperties.Name="Pin"
                                                  ToolTip="Keep the hologram on screen  (P)"/>
                                    <Button x:Name="HideBtn"
                                            Style="{StaticResource ToolbarIconButton}"
                                            Tag="{StaticResource IconClose}"
                                            Click="OnHide"
                                            AutomationProperties.Name="Hide"
                                            ToolTip="Hide  (Esc)"/>
                                </StackPanel>
        
                                <!-- Press and hold to talk. Fills the space between the
                                     menu button and the toggles. -->
                                <Border x:Name="MicSurface"
                                        Margin="6,0"
                                        Background="#FF232323"
                                        BorderBrush="#FF3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="OnMicDown"
                                        PreviewMouseLeftButtonUp="OnMicUp"
                                        AutomationProperties.Name="Hold to talk"
                                        ToolTip="Hold to talk  (Ctrl+Shift+M)">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
        
                                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0">
                                            <Path x:Name="MicIcon"
                                                  Data="{StaticResource IconMic}"
                                                  Stroke="#FFB4B4B4"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="24" Height="24"
                                                  Stretch="None"/>
                                        </Viewbox>
        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="HeaderName"
                                                       Text="PERSONA"
                                                       Foreground="#FFEAEAEA"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MicHint"
                                                       Text="hold to talk"
                                                       Foreground="#FF8C8C8C"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Border>

            <!-- SYNTAX's prismatic ring, tracing the bar's perimeter. Drawn
                 last so it sits above the bar, and given the same corner radius
                 so it follows the bar exactly rather than boxing it. -->
            <local:PrismaticBorder x:Name="Ring" CornerRadius="14"/>
        </Grid>
    </Grid>
</Window>
