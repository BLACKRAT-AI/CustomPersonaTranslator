<Application x:Class="CPT.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml"/>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The tray menu is deliberately short. Everything that used to be
                 here now lives in the settings window, which the bar opens with
                 a single button. -->
            <ContextMenu x:Key="TrayMenu" x:Shared="false">
                <MenuItem Header="Show / hide persona" Click="OnShowHide"/>
                <MenuItem x:Name="StandbyMenuItem"
                          Header="Standby listening"
                          IsCheckable="True"
                          Click="OnToggleStandby"/>
                <MenuItem x:Name="PersonasMenu" Header="Switch persona"/>
                <Separator/>
                <MenuItem Header="Settings…" Click="OnSettings"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExit"/>
            </ContextMenu>
        </ResourceDictionary>
    </Application.Resources>
</Application>
