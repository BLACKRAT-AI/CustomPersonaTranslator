{
  "manifest_version": 3,
  "name": "CPT — Bridge",
  "version": "0.2.0",
  "description": "Captures Gemini final responses and forwards them to CustomPersonaTranslator. Also adds a right-click 'Translate with CPT' on any page or selection.",
  "permissions": ["storage", "scripting", "contextMenus", "activeTab"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "ws://127.0.0.1:17872/*",
    "http://127.0.0.1:17872/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CPT — Bridge",
    "default_popup": "popup.html"
  }
}
