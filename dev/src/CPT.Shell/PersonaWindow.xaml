<Window x:Class="CPT.Shell.PersonaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:CPT.Shell"
        Title="Persona"
        Width="520" Height="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <!-- NO panel. The hologram is projected onto nothing, exactly as SYNTAX
         does it: a transparent canvas, with a soft dark radial drawn only
         behind the head so the dots have contrast. A panel behind it clipped
         that radial and put a slab of glass on the screen.

         The modal is the bar at the bottom, and the prismatic ring traces THAT.
         The WebView2 is a child HWND that always paints over WPF, so the ring
         lives in the bar's own row where the WebView cannot cover it. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============== HOLOGRAM ZONE ============== -->
        <Grid Grid.Row="0" x:Name="HoloZone" ClipToBounds="True">
            <wv2:WebView2 x:Name="Web"/>
        </Grid>

        <Grid Grid.Row="1" Margin="26,0,26,24">
          <Border Background="#F2141619" BorderBrush="#FF33363D" BorderThickness="1" CornerRadius="14">
        <!-- ============== PROJECTOR BAR ============== -->
        <!-- Generous margin on purpose: the ring's bloom is a drop shadow and
             was being cut off square by the window edge. This is the room it
             needs to fade all the way to nothing. -->
        <Grid Margin="0">
            <Border x:Name="Bar"
                    Background="Transparent"
                    MinHeight="48"
                    BorderThickness="0"
                    CornerRadius="0"
                    MouseLeftButtonDown="OnBarDragStart"
                    MouseMove="OnBarDragMove"
                    MouseLeftButtonUp="OnBarDragEnd"
                    LostMouseCapture="OnBarDragCaptureLost"
                    Cursor="SizeAll">
                <Grid Margin="6,5" VerticalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        
                            <!-- Row 0: the controls. -->
                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button x:Name="SettingsBtn"
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource ToolbarIconButton}"
                                        Tag="{StaticResource IconSettings}"
                                        Click="OnOpenSettings"
                                        AutomationProperties.Name="Settings"
                                        ToolTip="Settings"/>
        
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Volume, with the slider in a popup the way the Windows
                                         tray control used to work. A slider in the bar itself
                                         would take room this bar does not have. -->
                                    <ToggleButton x:Name="VolumeToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconVolume}"
                                                  AutomationProperties.Name="Volume"
                                                  ToolTip="How loud replies are spoken"/>
                                    <Popup PlacementTarget="{Binding ElementName=VolumeToggle}"
                                           Placement="Top"
                                           VerticalOffset="-6"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           IsOpen="{Binding IsChecked, ElementName=VolumeToggle, Mode=TwoWay}">
                                        <Border Background="#F2141619"
                                                BorderBrush="#FF33363D"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,10">
                                            <StackPanel Width="48">
                                                <TextBlock x:Name="VolumeReadout"
                                                           Text="100%"
                                                           HorizontalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Muted}"
                                                           Margin="0,0,0,6"/>
                                                <Slider x:Name="VolumeSlider"
                                                        Orientation="Vertical"
                                                        Height="120"
                                                        HorizontalAlignment="Center"
                                                        Minimum="0" Maximum="1" Value="1"
                                                        SmallChange="0.05" LargeChange="0.1"
                                                        ValueChanged="OnVolumeChanged"
                                                        AutomationProperties.Name="Speaking volume"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <ToggleButton x:Name="StandbyToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconWaveform}"
                                                  Checked="OnStandbyChecked"
                                                  Unchecked="OnStandbyUnchecked"
                                                  AutomationProperties.Name="Standby"
                                                  ToolTip="Standby — wake with a spoken phrase  (S)"/>
                                    <ToggleButton x:Name="AvatarToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconAvatar}"
                                                  IsChecked="True"
                                                  Checked="OnAvatarToggled"
                                                  Unchecked="OnAvatarToggled"
                                                  AutomationProperties.Name="Avatar"
                                                  ToolTip="Show or hide the avatar  (A)"/>
                                    <ToggleButton x:Name="PinToggle"
                                                  Style="{StaticResource ToolbarIconToggle}"
                                                  Tag="{StaticResource IconPin}"
                                                  Checked="OnPinToggled"
                                                  Unchecked="OnPinToggled"
                                                  AutomationProperties.Name="Pin"
                                                  ToolTip="Keep the hologram on screen  (P)"/>
                                    <Button x:Name="HideBtn"
                                            Style="{StaticResource ToolbarIconButton}"
                                            Tag="{StaticResource IconClose}"
                                            Click="OnHide"
                                            AutomationProperties.Name="Hide"
                                            ToolTip="Hide  (Esc)"/>
                                </StackPanel>
        
                                <!-- Press and hold to talk. Fills the space between the
                                     menu button and the toggles. -->
                                <Border x:Name="MicSurface"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Margin="6,0"
                                        Background="#FF232323"
                                        BorderBrush="#FF3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="OnMicDown"
                                        PreviewMouseLeftButtonUp="OnMicUp"
                                        AutomationProperties.Name="Hold to talk"
                                        ToolTip="Hold to talk  (Ctrl+Shift+M)">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
        
                                        <Viewbox Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0">
                                            <Path x:Name="MicIcon"
                                                  Data="{StaticResource IconMic}"
                                                  Stroke="#FFB4B4B4"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="24" Height="24"
                                                  Stretch="None"/>
                                        </Viewbox>
        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="HeaderName"
                                                       Text="PERSONA"
                                                       Foreground="#FFEAEAEA"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MicHint"
                                                       Text="hold to talk"
                                                       Foreground="#FF8C8C8C"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- Stop. Sits inside the talk button and appears only
                                             while the agent is working, because a coding turn can
                                             run for a minute and there was no way out of one you
                                             did not mean to start. It swallows the click so the
                                             surrounding hold-to-talk does not also fire. -->
                                        <Border x:Name="CancelButton"
                                                Grid.Column="2"
                                                Width="20" Height="20"
                                                Margin="6,0,2,0"
                                                VerticalAlignment="Center"
                                                Background="#FF3A2323"
                                                BorderBrush="#FF6E3A3A"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Cursor="Hand"
                                                Visibility="Collapsed"
                                                PreviewMouseLeftButtonDown="OnCancelAgent"
                                                AutomationProperties.Name="Stop the agent"
                                                ToolTip="Stop what the agent is doing  (Esc)">
                                            <TextBlock Text="&#x2715;"
                                                       Foreground="#FFFF9B9B"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Ready to listen. A pulsing green dot inside the talk
                                             button, because standby's state is otherwise invisible:
                                             the tone says it woke, this says it still is. -->
                                        <Ellipse x:Name="ListeningDot"
                                                 Grid.Column="3"
                                                 Width="9" Height="9"
                                                 Margin="8,0,2,0"
                                                 VerticalAlignment="Center"
                                                 Fill="#FF4ADE80"
                                                 Visibility="Collapsed">
                                            <Ellipse.Effect>
                                                <DropShadowEffect ShadowDepth="0"
                                                                  BlurRadius="9"
                                                                  Opacity="0.9"
                                                                  Color="#FF4ADE80"/>
                                            </Ellipse.Effect>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1.0" To="0.25"
                                                                             Duration="0:0:0.9"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Border>

        </Grid>
          </Border>
          <local:PrismaticBorder x:Name="Ring" CornerRadius="14"/>
        </Grid>
    </Grid>
</Window>
